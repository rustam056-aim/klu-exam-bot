{
  "name": "klu-exam-practice",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  // The built React app (web/dist) is served as static files; /api/* goes to the Worker code.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
